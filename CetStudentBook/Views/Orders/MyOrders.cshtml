@model IReadOnlyList<CetStudentBook.Models.Order>

<h1>My Orders</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">No orders yet.</div>
    return;
}

@foreach (var order in Model)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>Order #@order.Id</strong> - @order.CreatedAt.ToLocalTime()
            <span class="float-end"><strong>Total:</strong> @order.TotalPrice</span>
        </div>
        <div class="card-body">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">Price</th>
                        <th class="text-end">Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-end">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice</td>
                            <td class="text-end">@(item.Quantity* item.UnitPrice)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}