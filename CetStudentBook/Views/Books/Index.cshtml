@model IReadOnlyList<CetStudentBook.Models.Book>

@{
    ViewData["Title"] = "Books";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Books</h2>
    <a class="btn btn-primary" asp-action="Create">Create</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Author</th>
            <th>Publish Date</th>
            <th>Page Count</th>
            <th>Second Hand</th>
            <th style="width: 180px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Name</td>
                <td>@book.Author</td>
                <td>@book.PublishDate.ToString("yyyy-MM-dd")</td>
                <td>@book.PageCount</td>
                <td>@(book.IsSecondHand ? "Yes" : "No")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@book.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>