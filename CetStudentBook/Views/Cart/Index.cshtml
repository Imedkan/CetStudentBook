@model IReadOnlyList<CetStudentBook.Models.CartItem>

<h1>Cart</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Your cart is empty.</div>
    return;
}

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th class="text-end">Quantity</th>
            <th class="text-end">Price</th>
            <th class="text-end">Line Total</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td class="text-end">@item.Quantity</td>
                <td class="text-end">@item.UnitPrice</td>
                <td class="text-end">@(item.Quantity* item.UnitPrice)</td>
                <td class="text-end">
                    <form asp-action="Remove" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="btn btn-outline-danger btn-sm" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="text-end">
    <strong>Total: @Model.Sum(i => i.Quantity * i.UnitPrice)</strong>
</div>

<form asp-action="Buy" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <button class="btn btn-primary" type="submit">Buy</button>
</form>