@model IReadOnlyList<CetStudentBook.Models.Category>

@foreach (var c in Model)
{
    <li class="nav-item">
        <a class="nav-link text-dark"
               asp-controller="Products"
               asp-action="Index"
               asp-route-categoryId="@c.Id">
            @c.Name
        </a>
    </li>
}